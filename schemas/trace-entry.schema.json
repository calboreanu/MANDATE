{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mandate:schema:trace-entry.schema.json",
  "title": "MANDATE trace entry",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "hash",
    "role",
    "decision_type",
    "timestamp",
    "parent_hashes"
  ],
  "properties": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "role": {
      "type": "string",
      "enum": [
        "Intake",
        "Interpreter",
        "Decomposition",
        "Procedure",
        "Binding",
        "Validation"
      ]
    },
    "decision_type": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "parent_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "query": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "k": {
          "type": "integer",
          "minimum": 0
        },
        "total_results": {
          "type": "integer",
          "minimum": 0
        },
        "ranker_version": {
          "type": "string"
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "selected": {
      "type": [
        "string",
        "null"
      ]
    },
    "selection_criteria": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "risk": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "score": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "UNASSESSABLE"
          ]
        },
        "primary_factor": {
          "type": "string"
        },
        "unassessable_reason": {
          "type": "string"
        }
      }
    },
    "rationale": {
      "type": "string"
    }
  }
}