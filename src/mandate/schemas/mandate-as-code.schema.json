{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mandate:schema:mandate-as-code.schema.json",
  "title": "MANDATE mandate-as-code",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mandate_id",
    "version",
    "generated",
    "anchor",
    "courses_of_action",
    "recommendation",
    "trace"
  ],
  "properties": {
    "mandate_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "generated": {
      "type": "string",
      "format": "date-time"
    },
    "risk_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_score",
        "requires_approval"
      ],
      "properties": {
        "max_score": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "UNASSESSABLE"
          ]
        },
        "requires_approval": {
          "type": "boolean"
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_intent",
        "minimum",
        "constraints",
        "anchor_hash"
      ],
      "properties": {
        "mission_intent": {
          "type": "string",
          "minLength": 1
        },
        "minimum": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "object"
              },
              {
                "type": "array"
              }
            ]
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "object"
              },
              {
                "type": "array"
              }
            ]
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "risk_tolerance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_autonomous_score": {
              "type": "string",
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH"
              ]
            },
            "escalate_above": {
              "type": "string",
              "enum": [
                "MEDIUM",
                "HIGH"
              ]
            }
          }
        },
        "anchor_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "courses_of_action": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "coa_id",
          "approach",
          "task_dag",
          "risk_assessment",
          "off_nominal_triggers"
        ],
        "properties": {
          "coa_id": {
            "type": "string",
            "minLength": 1
          },
          "approach": {
            "type": "string",
            "minLength": 1
          },
          "task_dag": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nodes",
              "edges"
            ],
            "properties": {
              "nodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "id",
                    "name"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "risk_factors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "from",
                    "to"
                  ],
                  "properties": {
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "procedures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risk_assessment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "score",
              "confidence_min",
              "confidence_target",
              "primary_factor"
            ],
            "properties": {
              "score": {
                "type": "string",
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH",
                  "UNASSESSABLE"
                ]
              },
              "confidence_min": {
                "type": "string",
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH"
                ]
              },
              "confidence_target": {
                "type": "string",
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH"
                ]
              },
              "primary_factor": {
                "type": "string"
              },
              "rubric": {
                "type": "string"
              }
            }
          },
          "off_nominal_triggers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "estimated_time": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_coa",
        "fallback_sequence",
        "rationale"
      ],
      "properties": {
        "primary_coa": {
          "type": "string"
        },
        "fallback_sequence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_hash",
        "entry_count",
        "entries"
      ],
      "properties": {
        "chain_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "entries": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "$ref": "urn:mandate:schema:trace-entry.schema.json"
              }
            ]
          }
        }
      }
    },
    "registry_reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "similar_mandates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "match_type": {
          "type": "string",
          "enum": [
            "IDENTICAL",
            "TEMPLATE",
            "COMPARABLE",
            "SIMILAR",
            "NOVEL"
          ]
        },
        "similarity_description": {
          "type": "string"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "input_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "output_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sources_consulted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}