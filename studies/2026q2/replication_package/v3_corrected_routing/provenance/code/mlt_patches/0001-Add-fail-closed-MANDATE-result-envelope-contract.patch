diff --git a/tests/mandate/test_execution_contract.py b/tests/mandate/test_execution_contract.py
new file mode 100644
index 0000000..528a08c
--- /dev/null
+++ b/tests/mandate/test_execution_contract.py
@@ -0,0 +1,253 @@
+from __future__ import annotations
+
+from mlt.mandate.execution_contract import (
+    CONTRACT_SCHEMA_VERSION,
+    ExecutionState,
+    build_result_envelope,
+    derive_execution_state,
+    validate_result_envelope,
+)
+
+
+ARTIFACT = {"mandate_id": "M-1"}
+VALIDATION_FAIL = {"minimum_satisfaction": {"passed": False}}
+
+
+def _gap(**overrides):
+    gap = {
+        "severity": "DEGRADING",
+        "readiness_score": {"blocking": False},
+        "readiness_assessment": {
+            "blocking_gap_count": 0,
+            "recommendation": "PROCEED_WITH_CAVEATS",
+        },
+    }
+    gap.update(overrides)
+    return gap
+
+
+def _state(**kwargs) -> ExecutionState:
+    defaults = {
+        "ok": False,
+        "artifact": ARTIFACT,
+        "gap_reports": [],
+        "schema_valid": True,
+        "errors": [],
+        "validation": None,
+    }
+    defaults.update(kwargs)
+    return derive_execution_state(**defaults)
+
+
+def _envelope(**overrides):
+    envelope = {
+        "contract_schema_version": CONTRACT_SCHEMA_VERSION,
+        "ok": False,
+        "execution_state": "NON_EXECUTABLE_GAPS",
+        "output_representation": "MANDATE_AS_CODE",
+        "artifact_present": True,
+        "schema_valid": True,
+        "gap_report_count": 1,
+        "has_blocking_or_insufficient_signal": True,
+        "validation_failure_present": False,
+        "errors_present": False,
+        "missing_result": False,
+    }
+    envelope.update(overrides)
+    return envelope
+
+
+def _issues(envelope, *, artifact=ARTIFACT, gap_reports=None, schema_valid=True, errors=None, validation=None):
+    return validate_result_envelope(
+        envelope,
+        artifact=artifact,
+        gap_reports=[_gap(severity="BLOCKING")] if gap_reports is None else gap_reports,
+        schema_valid=schema_valid,
+        errors=[] if errors is None else errors,
+        validation=validation,
+    )
+
+
+def test_blocking_severity_routes_to_non_executable_gaps():
+    assert _state(gap_reports=[_gap(severity="BLOCKING")]) is ExecutionState.NON_EXECUTABLE_GAPS
+
+
+def test_blocking_true_routes_to_non_executable_gaps():
+    assert _state(gap_reports=[_gap(blocking=True)]) is ExecutionState.NON_EXECUTABLE_GAPS
+
+
+def test_insufficient_readiness_routes_to_non_executable_gaps():
+    gap = _gap(
+        readiness_assessment={
+            "blocking_gap_count": 0,
+            "recommendation": "INSUFFICIENT_FOR_AUTOMATION",
+        }
+    )
+    assert _state(gap_reports=[gap]) is ExecutionState.NON_EXECUTABLE_GAPS
+
+
+def test_minimum_satisfaction_failure_routes_to_non_executable_validation():
+    validation = {"minimum_satisfaction": {"passed": False}}
+    assert _state(validation=validation) is ExecutionState.NON_EXECUTABLE_VALIDATION
+
+
+def test_constraint_compliance_failure_routes_to_non_executable_validation():
+    validation = {"constraint_compliance": {"passed": False}}
+    assert _state(validation=validation) is ExecutionState.NON_EXECUTABLE_VALIDATION
+
+
+def test_artifact_schema_failure_routes_to_non_executable_validation():
+    assert _state(ok=True, schema_valid=False) is ExecutionState.NON_EXECUTABLE_VALIDATION
+
+
+def test_clean_schema_valid_success_routes_to_executable():
+    assert _state(ok=True, schema_valid=True) is ExecutionState.EXECUTABLE
+
+
+def test_schema_rejects_executable_with_ok_false():
+    envelope = _envelope(
+        execution_state="EXECUTABLE",
+        ok=False,
+        gap_report_count=0,
+        has_blocking_or_insufficient_signal=False,
+    )
+    assert _issues(envelope, gap_reports=[])
+
+
+def test_schema_rejects_executable_with_unresolved_blocking_gap():
+    gap = _gap(severity="BLOCKING")
+    envelope = _envelope(execution_state="EXECUTABLE", ok=True)
+    issues = _issues(envelope, gap_reports=[gap])
+    assert issues
+
+
+def test_schema_rejects_missing_execution_state():
+    envelope = build_result_envelope(
+        ok=True,
+        artifact=ARTIFACT,
+        gap_reports=[],
+        schema_valid=True,
+    )
+    envelope.pop("execution_state")
+    assert validate_result_envelope(envelope, artifact=ARTIFACT, gap_reports=[])
+
+
+def test_build_normalizes_non_executable_gap_ok_false():
+    envelope = build_result_envelope(
+        ok=True,
+        artifact=ARTIFACT,
+        gap_reports=[_gap(severity="BLOCKING")],
+        schema_valid=True,
+    )
+    assert envelope["execution_state"] == "NON_EXECUTABLE_GAPS"
+    assert envelope["ok"] is False
+
+
+def test_schema_rejects_non_executable_gaps_with_ok_true():
+    assert _issues(_envelope(ok=True))
+
+
+def test_schema_rejects_non_executable_validation_with_ok_true():
+    envelope = _envelope(
+        ok=True,
+        execution_state="NON_EXECUTABLE_VALIDATION",
+        schema_valid=False,
+        has_blocking_or_insufficient_signal=False,
+        gap_report_count=0,
+        validation_failure_present=True,
+    )
+    assert _issues(envelope, gap_reports=[], schema_valid=False)
+
+
+def test_schema_rejects_failed_with_ok_true():
+    envelope = _envelope(
+        ok=True,
+        execution_state="FAILED",
+        output_representation="NONE",
+        artifact_present=False,
+        schema_valid=None,
+        gap_report_count=0,
+        has_blocking_or_insufficient_signal=False,
+        errors_present=True,
+        missing_result=True,
+    )
+    assert _issues(envelope, artifact=None, gap_reports=[], schema_valid=None, errors=["boom"])
+
+
+def test_executable_rejects_blocking_true():
+    gap = _gap(blocking=True)
+    envelope = _envelope(execution_state="EXECUTABLE", ok=True)
+    assert _issues(envelope, gap_reports=[gap])
+
+
+def test_executable_rejects_readiness_score_blocking():
+    gap = _gap(readiness_score={"blocking": True})
+    envelope = _envelope(execution_state="EXECUTABLE", ok=True)
+    assert _issues(envelope, gap_reports=[gap])
+
+
+def test_executable_rejects_blocking_gap_count():
+    gap = _gap(readiness_assessment={"blocking_gap_count": 1, "recommendation": "PROCEED_WITH_CAVEATS"})
+    envelope = _envelope(execution_state="EXECUTABLE", ok=True)
+    assert _issues(envelope, gap_reports=[gap])
+
+
+def test_executable_rejects_insufficient_for_automation():
+    gap = _gap(readiness_assessment={"blocking_gap_count": 0, "recommendation": "INSUFFICIENT_FOR_AUTOMATION"})
+    envelope = _envelope(execution_state="EXECUTABLE", ok=True)
+    assert _issues(envelope, gap_reports=[gap])
+
+
+def test_schema_rejects_missing_required_envelope_field():
+    envelope = build_result_envelope(
+        ok=False,
+        artifact=ARTIFACT,
+        gap_reports=[_gap(severity="BLOCKING")],
+        schema_valid=True,
+    )
+    envelope.pop("validation_failure_present")
+    assert _issues(envelope)
+
+
+def test_schema_rejects_unknown_contract_version():
+    envelope = build_result_envelope(
+        ok=False,
+        artifact=ARTIFACT,
+        gap_reports=[_gap(severity="BLOCKING")],
+        schema_valid=True,
+    )
+    envelope["contract_schema_version"] = "bogus.v999"
+    assert _issues(envelope)
+
+
+def test_non_executable_validation_requires_validation_evidence():
+    envelope = _envelope(
+        execution_state="NON_EXECUTABLE_VALIDATION",
+        ok=False,
+        gap_report_count=0,
+        has_blocking_or_insufficient_signal=False,
+        validation_failure_present=False,
+    )
+    assert _issues(envelope, gap_reports=[])
+
+
+def test_non_executable_validation_accepts_schema_failure():
+    envelope = build_result_envelope(
+        ok=True,
+        artifact=ARTIFACT,
+        gap_reports=[],
+        schema_valid=False,
+    )
+    assert envelope["execution_state"] == "NON_EXECUTABLE_VALIDATION"
+    assert not _issues(envelope, gap_reports=[], schema_valid=False)
+
+
+def test_failed_accepts_missing_result():
+    envelope = build_result_envelope(
+        ok=False,
+        artifact=None,
+        gap_reports=[],
+        schema_valid=None,
+    )
+    assert envelope["execution_state"] == "FAILED"
+    assert not _issues(envelope, artifact=None, gap_reports=[], schema_valid=None)
