diff --git a/src/mlt/mandate/execution_contract.py b/src/mlt/mandate/execution_contract.py
new file mode 100644
index 0000000..b719102
--- /dev/null
+++ b/src/mlt/mandate/execution_contract.py
@@ -0,0 +1,274 @@
+"""Explicit execution-state contract for MANDATE pipeline results."""
+from __future__ import annotations
+
+from enum import Enum
+from functools import lru_cache
+from typing import Any, Mapping, Sequence
+
+from jsonschema import Draft202012Validator
+
+from .schema import load_schema
+
+
+CONTRACT_SCHEMA_VERSION = "mandate-result-envelope.v1"
+RESULT_ENVELOPE_SCHEMA_NAME = "mandate-result-envelope.schema.json"
+OUTPUT_MANDATE_AS_CODE = "MANDATE_AS_CODE"
+OUTPUT_GAP_REPORT = "GAP_REPORT"
+OUTPUT_NONE = "NONE"
+
+
+class ExecutionState(str, Enum):
+    EXECUTABLE = "EXECUTABLE"
+    NON_EXECUTABLE_GAPS = "NON_EXECUTABLE_GAPS"
+    NON_EXECUTABLE_VALIDATION = "NON_EXECUTABLE_VALIDATION"
+    FAILED = "FAILED"
+
+
+def _enum_value(value: Any) -> str:
+    raw = getattr(value, "value", value)
+    return str(raw or "").upper()
+
+
+def is_blocking_or_insufficient_gap(gap: Mapping[str, Any]) -> bool:
+    """Return True when a gap carries a blocking or insufficient signal."""
+    if not isinstance(gap, Mapping):
+        return False
+    if _enum_value(gap.get("severity")) == "BLOCKING":
+        return True
+    if gap.get("blocking") is True:
+        return True
+
+    readiness_score = gap.get("readiness_score")
+    if isinstance(readiness_score, Mapping) and readiness_score.get("blocking") is True:
+        return True
+
+    readiness = gap.get("readiness_assessment")
+    if isinstance(readiness, Mapping):
+        if int(readiness.get("blocking_gap_count") or 0) > 0:
+            return True
+        if _enum_value(readiness.get("recommendation")) == "INSUFFICIENT_FOR_AUTOMATION":
+            return True
+
+    state = _enum_value(gap.get("execution_state"))
+    return state in {ExecutionState.NON_EXECUTABLE_GAPS.value, "INSUFFICIENT_FOR_AUTOMATION"}
+
+
+def has_blocking_or_insufficient_signal(gap_reports: Sequence[Mapping[str, Any]]) -> bool:
+    return any(is_blocking_or_insufficient_gap(gap) for gap in list(gap_reports or []))
+
+
+def validation_gate_failed(validation: Mapping[str, Any] | None) -> bool:
+    """Return True for minimum-satisfaction or constraint-compliance failure."""
+    if not isinstance(validation, Mapping):
+        return False
+    for key in ("minimum_satisfaction", "constraint_compliance"):
+        step = validation.get(key)
+        if isinstance(step, Mapping) and step.get("passed") is False:
+            return True
+    return False
+
+
+def derive_execution_state(
+    *,
+    ok: bool,
+    artifact: Mapping[str, Any] | None,
+    gap_reports: Sequence[Mapping[str, Any]] | None,
+    schema_valid: bool | None,
+    errors: Sequence[Any] | None = None,
+    validation: Mapping[str, Any] | None = None,
+) -> ExecutionState:
+    """Derive the closed execution state with fail-closed precedence.
+
+    Precedence is deterministic:
+    1. no artifact and no gap report is a failed/missing result;
+    2. blocking or insufficient-for-automation gap signals are non-executable gaps;
+    3. minimum, constraint, or artifact-schema failures are non-executable validation;
+    4. only ok=True plus a schema-valid artifact is executable;
+    5. everything else is failed.
+    """
+    gaps = list(gap_reports or [])
+    if artifact is None and not gaps:
+        return ExecutionState.FAILED
+    if has_blocking_or_insufficient_signal(gaps):
+        return ExecutionState.NON_EXECUTABLE_GAPS
+    if validation_gate_failed(validation) or schema_valid is False:
+        return ExecutionState.NON_EXECUTABLE_VALIDATION
+    if ok and artifact is not None and schema_valid is True:
+        return ExecutionState.EXECUTABLE
+    if errors:
+        return ExecutionState.FAILED
+    return ExecutionState.NON_EXECUTABLE_VALIDATION if artifact is not None else ExecutionState.FAILED
+
+
+def output_representation(
+    artifact: Mapping[str, Any] | None,
+    gap_reports: Sequence[Mapping[str, Any]] | None,
+) -> str:
+    if artifact is not None:
+        return OUTPUT_MANDATE_AS_CODE
+    if gap_reports:
+        return OUTPUT_GAP_REPORT
+    return OUTPUT_NONE
+
+
+def build_result_envelope(
+    *,
+    ok: bool,
+    artifact: Mapping[str, Any] | None,
+    gap_reports: Sequence[Mapping[str, Any]] | None,
+    schema_valid: bool | None,
+    errors: Sequence[Any] | None = None,
+    validation: Mapping[str, Any] | None = None,
+    execution_state: ExecutionState | str | None = None,
+) -> dict[str, Any]:
+    gaps = list(gap_reports or [])
+    validation_failed = validation_gate_failed(validation) or schema_valid is False
+    missing_result = artifact is None and not gaps
+    state = (
+        execution_state
+        if isinstance(execution_state, ExecutionState)
+        else ExecutionState(str(execution_state))
+        if execution_state is not None
+        else derive_execution_state(
+            ok=ok,
+            artifact=artifact,
+            gap_reports=gaps,
+            schema_valid=schema_valid,
+            errors=errors,
+            validation=validation,
+        )
+    )
+    contract_ok = bool(ok) and state is ExecutionState.EXECUTABLE
+    return {
+        "contract_schema_version": CONTRACT_SCHEMA_VERSION,
+        "ok": contract_ok,
+        "execution_state": state.value,
+        "output_representation": output_representation(artifact, gaps),
+        "artifact_present": artifact is not None,
+        "schema_valid": schema_valid,
+        "gap_report_count": len(gaps),
+        "has_blocking_or_insufficient_signal": has_blocking_or_insufficient_signal(gaps),
+        "validation_failure_present": validation_failed,
+        "errors_present": bool(errors),
+        "missing_result": missing_result,
+    }
+
+
+@lru_cache(maxsize=1)
+def _result_envelope_validator() -> Draft202012Validator:
+    return Draft202012Validator(load_schema(RESULT_ENVELOPE_SCHEMA_NAME))
+
+
+def validate_result_envelope(
+    envelope: Mapping[str, Any],
+    *,
+    artifact: Mapping[str, Any] | None = None,
+    gap_reports: Sequence[Mapping[str, Any]] | None = None,
+    schema_valid: bool | None = None,
+    errors: Sequence[Any] | None = None,
+    validation: Mapping[str, Any] | None = None,
+) -> list[str]:
+    """Validate a result envelope and semantic execution-state invariants."""
+    issues: list[str] = []
+    for err in sorted(_result_envelope_validator().iter_errors(dict(envelope)), key=str):
+        path = "/".join(str(p) for p in err.absolute_path)
+        issues.append(f"{path}: {err.message}" if path else err.message)
+    if "execution_state" not in envelope:
+        return issues
+
+    try:
+        state = ExecutionState(str(envelope["execution_state"]))
+    except Exception:
+        return issues
+    ok = bool(envelope.get("ok"))
+    envelope_schema_valid = envelope.get("schema_valid")
+    artifact_present = bool(envelope.get("artifact_present"))
+    gaps = list(gap_reports or [])
+    actual_schema_valid = envelope_schema_valid if schema_valid is None else schema_valid
+    expected_blocking = has_blocking_or_insufficient_signal(gaps)
+    expected_missing = artifact is None and not gaps
+    expected_errors = bool(errors) if errors is not None else bool(envelope.get("errors_present"))
+    expected_validation_failed = (
+        validation_gate_failed(validation) or actual_schema_valid is False
+    )
+
+    if ok != (state is ExecutionState.EXECUTABLE):
+        issues.append(f"{state.value} requires ok={'true' if state is ExecutionState.EXECUTABLE else 'false'}")
+
+    if state is ExecutionState.EXECUTABLE:
+        if not artifact_present or artifact is None:
+            issues.append("EXECUTABLE requires an artifact")
+        if envelope_schema_valid is not True or actual_schema_valid is not True:
+            issues.append("EXECUTABLE requires schema_valid=true")
+        if expected_blocking:
+            issues.append("EXECUTABLE cannot coexist with blocking or insufficient gap signals")
+        if expected_validation_failed:
+            issues.append("EXECUTABLE cannot coexist with validation failure")
+        if expected_errors:
+            issues.append("EXECUTABLE cannot coexist with errors")
+        if expected_missing:
+            issues.append("EXECUTABLE cannot be a missing result")
+
+    if state is ExecutionState.NON_EXECUTABLE_GAPS:
+        if ok:
+            issues.append("NON_EXECUTABLE_GAPS requires ok=false")
+        if not expected_blocking:
+            issues.append("NON_EXECUTABLE_GAPS requires a blocking or insufficient gap signal")
+
+    if state is ExecutionState.NON_EXECUTABLE_VALIDATION:
+        if ok:
+            issues.append("NON_EXECUTABLE_VALIDATION requires ok=false")
+        if expected_blocking:
+            issues.append("NON_EXECUTABLE_VALIDATION cannot hide blocking or insufficient gap signals")
+        if not expected_validation_failed:
+            issues.append("NON_EXECUTABLE_VALIDATION requires a validation or schema failure")
+
+    if state is ExecutionState.FAILED:
+        if ok:
+            issues.append("FAILED requires ok=false")
+        if not (expected_errors or expected_missing):
+            issues.append("FAILED requires errors or a missing-result condition")
+
+    if envelope.get("contract_schema_version") != CONTRACT_SCHEMA_VERSION:
+        issues.append("contract_schema_version does not match this validator")
+
+    if envelope.get("has_blocking_or_insufficient_signal") != expected_blocking:
+        issues.append(
+            "has_blocking_or_insufficient_signal mismatch: "
+            f"{envelope.get('has_blocking_or_insufficient_signal')} != {expected_blocking}"
+        )
+    if envelope.get("gap_report_count") != len(gaps):
+        issues.append(f"gap_report_count mismatch: {envelope.get('gap_report_count')} != {len(gaps)}")
+    if artifact_present != (artifact is not None):
+        issues.append(f"artifact_present mismatch: {artifact_present} != {artifact is not None}")
+    if envelope_schema_valid != actual_schema_valid:
+        issues.append(f"schema_valid mismatch: {envelope_schema_valid} != {actual_schema_valid}")
+    if envelope.get("validation_failure_present") != expected_validation_failed:
+        issues.append(
+            "validation_failure_present mismatch: "
+            f"{envelope.get('validation_failure_present')} != {expected_validation_failed}"
+        )
+    if envelope.get("errors_present") != expected_errors:
+        issues.append(f"errors_present mismatch: {envelope.get('errors_present')} != {expected_errors}")
+    if envelope.get("missing_result") != expected_missing:
+        issues.append(f"missing_result mismatch: {envelope.get('missing_result')} != {expected_missing}")
+
+    expected_representation = output_representation(artifact, gaps)
+    if envelope.get("output_representation") != expected_representation:
+        issues.append(
+            "output_representation mismatch: "
+            f"{envelope.get('output_representation')} != {expected_representation}"
+        )
+    return issues
+
+
+__all__ = [
+    "CONTRACT_SCHEMA_VERSION",
+    "ExecutionState",
+    "build_result_envelope",
+    "derive_execution_state",
+    "has_blocking_or_insufficient_signal",
+    "is_blocking_or_insufficient_gap",
+    "output_representation",
+    "validate_result_envelope",
+]
