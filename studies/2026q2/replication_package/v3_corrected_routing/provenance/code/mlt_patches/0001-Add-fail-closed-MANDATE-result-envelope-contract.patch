+        ]
+      },
+      "then": {
+        "properties": {
+          "ok": {
+            "const": false
+          }
+        },
+        "anyOf": [
+          {
+            "properties": {
+              "errors_present": {
+                "const": true
+              }
+            }
+          },
+          {
+            "properties": {
+              "missing_result": {
+                "const": true
+              }
+            }
+          }
+        ]
+      }
+    },
+    {
+      "if": {
+        "properties": {
+          "missing_result": {
+            "const": true
+          }
+        },
+        "required": [
+          "missing_result"
+        ]
+      },
+      "then": {
+        "properties": {
+          "artifact_present": {
+            "const": false
+          },
+          "gap_report_count": {
+            "const": 0
+          },
+          "output_representation": {
+            "const": "NONE"
+          }
+        }
+      }
+    }
+  ]
+}
