diff --git a/src/mlt/schemas/mandate-result-envelope.schema.json b/src/mlt/schemas/mandate-result-envelope.schema.json
new file mode 100644
index 0000000..7da282b
--- /dev/null
+++ b/src/mlt/schemas/mandate-result-envelope.schema.json
@@ -0,0 +1,223 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "urn:mandate:schema:mandate-result-envelope.schema.json",
+  "title": "MANDATE result execution envelope",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "contract_schema_version",
+    "ok",
+    "execution_state",
+    "output_representation",
+    "artifact_present",
+    "schema_valid",
+    "gap_report_count",
+    "has_blocking_or_insufficient_signal",
+    "validation_failure_present",
+    "errors_present",
+    "missing_result"
+  ],
+  "properties": {
+    "contract_schema_version": {
+      "type": "string",
+      "const": "mandate-result-envelope.v1"
+    },
+    "ok": {
+      "type": "boolean"
+    },
+    "execution_state": {
+      "type": "string",
+      "enum": [
+        "EXECUTABLE",
+        "NON_EXECUTABLE_GAPS",
+        "NON_EXECUTABLE_VALIDATION",
+        "FAILED"
+      ]
+    },
+    "output_representation": {
+      "type": "string",
+      "enum": [
+        "MANDATE_AS_CODE",
+        "GAP_REPORT",
+        "NONE"
+      ]
+    },
+    "artifact_present": {
+      "type": "boolean"
+    },
+    "schema_valid": {
+      "type": [
+        "boolean",
+        "null"
+      ]
+    },
+    "gap_report_count": {
+      "type": "integer",
+      "minimum": 0
+    },
+    "has_blocking_or_insufficient_signal": {
+      "type": "boolean"
+    },
+    "validation_failure_present": {
+      "type": "boolean"
+    },
+    "errors_present": {
+      "type": "boolean"
+    },
+    "missing_result": {
+      "type": "boolean"
+    }
+  },
+  "allOf": [
+    {
+      "if": {
+        "properties": {
+          "execution_state": {
+            "const": "EXECUTABLE"
+          }
+        },
+        "required": [
+          "execution_state"
+        ]
+      },
+      "then": {
+        "properties": {
+          "ok": {
+            "const": true
+          },
+          "artifact_present": {
+            "const": true
+          },
+          "schema_valid": {
+            "const": true
+          },
+          "has_blocking_or_insufficient_signal": {
+            "const": false
+          },
+          "validation_failure_present": {
+            "const": false
+          },
+          "errors_present": {
+            "const": false
+          },
+          "missing_result": {
+            "const": false
+          }
+        }
+      }
+    },
+    {
+      "if": {
+        "properties": {
+          "execution_state": {
+            "const": "NON_EXECUTABLE_GAPS"
+          }
+        },
+        "required": [
+          "execution_state"
+        ]
+      },
+      "then": {
+        "properties": {
+          "ok": {
+            "const": false
+          },
+          "has_blocking_or_insufficient_signal": {
+            "const": true
+          },
+          "missing_result": {
+            "const": false
+          }
+        }
+      }
+    },
+    {
+      "if": {
+        "properties": {
+          "execution_state": {
+            "const": "NON_EXECUTABLE_VALIDATION"
+          }
+        },
+        "required": [
+          "execution_state"
+        ]
+      },
+      "then": {
+        "properties": {
+          "ok": {
+            "const": false
+          },
+          "has_blocking_or_insufficient_signal": {
+            "const": false
+          },
+          "validation_failure_present": {
+            "const": true
+          },
+          "missing_result": {
+            "const": false
+          }
+        }
+      }
+    },
+    {
+      "if": {
+        "properties": {
+          "execution_state": {
+            "const": "FAILED"
+          }
+        },
